# EmailJS (recommended)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Formspree fallback (optional)
# Provide either a full endpoint or just the form id.
VITE_FORMSPREE_ENDPOINT=
VITE_FORMSPREE_FORM_ID=

# Local SMTP backend (recommended if you run `server/index.js`)
# Leave empty to use the Vite proxy (`/api/contact`) in development.
VITE_CONTACT_API_URL=
